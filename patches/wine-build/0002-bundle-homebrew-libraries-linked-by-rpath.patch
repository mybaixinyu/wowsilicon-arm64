diff --git a/bin/bundle-wine.sh b/bin/bundle-wine.sh
index ea0ef3d..5acb478 100755
--- a/bin/bundle-wine.sh
+++ b/bin/bundle-wine.sh
@@ -1600,6 +1600,10 @@ while :; do
     added=0
     for dylib in "$EXT_DIR"/*.dylib; do
         for dep in $(otool -L "$dylib" | tail -n +3 | awk '{print $1}'); do
+            # Homebrew links some libraries to their siblings by @rpath (brotli).
+            case "$dep" in
+                @rpath/*) dep="$DEPS_PREFIX/lib/${dep#@rpath/}" ;;
+            esac
             case "$dep" in
                 "$DEPS_PREFIX"/*)
                     depname=$(basename "$dep")
@@ -1632,7 +1636,7 @@ for dylib in "$EXT_DIR"/*.dylib; do
     install_name_tool -id "@loader_path/$name" "$dylib"
     for dep in $(otool -L "$dylib" | tail -n +2 | awk '{print $1}'); do
         case "$dep" in
-            "$DEPS_PREFIX"/*)
+            "$DEPS_PREFIX"/*|@rpath/*)
                 depname=$(basename "$dep")
                 if [ -f "$EXT_DIR/$depname" ]; then
                     install_name_tool -change "$dep" "@loader_path/$depname" "$dylib"
@@ -1641,6 +1645,14 @@ for dylib in "$EXT_DIR"/*.dylib; do
         esac
     done
 done
+# An @rpath reference left over has no LC_RPATH in the bundle to resolve it.
+for dylib in "$EXT_DIR"/*.dylib; do
+    if otool -L "$dylib" | tail -n +2 | grep -q '@rpath/'; then
+        echo "Error: $(basename "$dylib") still loads by @rpath:"
+        otool -L "$dylib" | grep '@rpath/'
+        exit 1
+    fi
+done
 
 # install_name_tool breaks the signature Homebrew's linker gave each dylib,
 # and arm64 code with a broken signature is killed on load. An ad-hoc
