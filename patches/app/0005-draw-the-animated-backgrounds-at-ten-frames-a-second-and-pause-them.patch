+/// The date every ECOPhaseView draws from, advanced ten times a second while
+/// one of them runs. One clock changes them all in the same frame; a clock
+/// each drew twice as many frames.
+@MainActor
+@Observable
+final class ECOClock {
+
+    static let shared = ECOClock()
+
+    private(set) var date = Date()
+
+    @ObservationIgnored
+    private var users = 0
+
+    @ObservationIgnored
+    private var ticker: Task<Void, Never>?
+
+    func retain() {
+        users += 1
+        guard ticker == nil else {
+            return
+        }
+        ticker = Task {
+            while !Task.isCancelled {
+                date = Date()
+                try? await Task.sleep(for: .seconds(0.1))
+            }
+        }
+    }
+
+    func release() {
+        users -= 1
+        guard users == 0 else {
+            return
+        }
+        ticker?.cancel()
+        ticker = nil
     }
 }
