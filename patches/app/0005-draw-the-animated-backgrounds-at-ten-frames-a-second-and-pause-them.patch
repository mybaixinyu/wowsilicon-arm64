+/// Draws its content with a phase that goes from 0 to 1 and back, `duration`
+/// seconds each way, from ECOClock, and not at all while the window is
+/// inactive or the game runs; disabled, at phase 0. A repeating animation,
+/// and a TimelineView whose next entry is less than 0.25 s away, redraws the
+/// window on every display refresh: NSHostingView updates on the next frame
+/// for any shorter delay.
+struct ECOPhaseView<Content: View>: View {
+
+    let duration: Double
+
+    var easeInOut = false
+
+    var isEnabled = true
+
+    @ViewBuilder
+    let content: (Double) -> Content
+
     @Environment(\.isGameRunning)
     private var isGameRunning
-    
+
     @Environment(\.appearsActive)
     private var appearsActive
-    
-    private var isEnabled: Bool {
-        appearsActive && !isGameRunning
+
+    private var isPaused: Bool {
+        !isEnabled || !appearsActive || isGameRunning
     }
-    
-    func body(content: Content) -> some View {
-        content
-            .animation(isEnabled ? animation : .default, value: trigger)
-            .onChange(of: isEnabled) {
-                trigger.toggle()
+
+    var body: some View {
+        content(isEnabled ? phase(at: ECOClock.shared.date) : 0)
+            .task(id: isPaused) { [isPaused] in
+                guard !isPaused else {
+                    return
+                }
+                ECOClock.shared.retain()
+                defer { ECOClock.shared.release() }
+                while !Task.isCancelled {
+                    try? await Task.sleep(for: .seconds(3600))
+                }
             }
     }
+
+    private func phase(at date: Date) -> Double {
+        let time = date.timeIntervalSinceReferenceDate.truncatingRemainder(dividingBy: 2 * duration) / duration
+        let phase = time <= 1 ? time : 2 - time
+        return easeInOut ? phase * phase * (3 - 2 * phase) : phase
+    }
 }
 
