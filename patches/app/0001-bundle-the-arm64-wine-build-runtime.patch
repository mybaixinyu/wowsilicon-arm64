-  echo "Embedded runtime lock not found: $embedded_manifest" >&2
-  exit 1
-}
-
-cmp -s "$manifest" "$embedded_manifest" || {
-  echo "Embedded runtime lock does not match the repository lock." >&2
-  exit 1
-}
-
