+  file "$executable" | grep -q 'arm64' || {
+    echo "Runtime executable does not support arm64: $executable" >&2
     exit 1
   }
 done
 
 for module_root in \
   "$runtime/lib/wine/i386-windows" \
-  "$runtime/lib/wine/x86_64-windows" \
