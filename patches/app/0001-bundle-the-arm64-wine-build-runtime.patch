-      echo "Assembled checksum mismatch: $path" >&2
-      echo "Expected: $expected" >&2
-      echo "Actual:   $actual" >&2
-      exit 1
-    }
-  done
+# The loader keeps the signature that grants it its entitlements; re-signing it breaks Wine.
+loader_app="$runtime/lib/wine/aarch64-unix/wine.app"
