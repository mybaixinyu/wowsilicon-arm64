diff --git a/Sources/WoWSiliconSwift/Services/ProcessArguments.swift b/Sources/WoWSiliconSwift/Services/ProcessArguments.swift
new file mode 100644
index 0000000..7812773
--- /dev/null
+++ b/Sources/WoWSiliconSwift/Services/ProcessArguments.swift
@@ -0,0 +1,73 @@
+import Darwin
+
+enum ProcessArguments {
+    /// `pid command` lines in the form of `ps -axo pid=,command=`, for the processes whose arguments
+    /// contain one of `markers` or whose first argument's file name is one of `names`, both compared
+    /// with ASCII letters lowered. Reading the arguments in process skips spawning ps and turning the
+    /// whole process table into Swift strings, which took about 160 ms a poll against 26 ms.
+    static func commandLines(markers: [String], names: Set<String>) -> String? {
+        var argumentMaximum: Int32 = 0
+        var size = MemoryLayout<Int32>.size
+        var argumentMaximumMIB = [CTL_KERN, KERN_ARGMAX]
+        guard sysctl(&argumentMaximumMIB, 2, &argumentMaximum, &size, nil, 0) == 0, argumentMaximum > 0 else {
+            return nil
+        }
+        let capacity = proc_listallpids(nil, 0)
+        guard capacity > 0 else { return nil }
+        // Room for processes started between the two calls.
+        var processIDs = [pid_t](repeating: 0, count: Int(capacity) + 64)
+        let count = processIDs.withUnsafeMutableBufferPointer {
+            proc_listallpids($0.baseAddress, Int32($0.count * MemoryLayout<pid_t>.size))
+        }
+        guard count > 0 else { return nil }
+
+        let loweredMarkers = markers.filter { !$0.isEmpty }.map { lowered(Array($0.utf8)) }
+        var buffer = [UInt8](repeating: 0, count: Int(argumentMaximum))
+        var lines = ""
+        for processID in processIDs.prefix(Int(count)) where processID > 0 {
+            guard let arguments = arguments(of: processID, buffer: &buffer), !arguments.isEmpty else { continue }
+            let loweredArguments = lowered(arguments)
+            let first = loweredArguments.split(separator: 0, omittingEmptySubsequences: false).first ?? []
+            let firstName = String(decoding: first.split(separator: UInt8(ascii: "/")).last ?? [], as: UTF8.self)
+            guard names.contains(firstName)
+                    || loweredMarkers.contains(where: { loweredArguments.firstRange(of: $0) != nil }) else {
+                continue
+            }
+            let command = String(decoding: arguments.map { $0 == 0 ? UInt8(ascii: " ") : $0 }, as: UTF8.self)
+            lines += "\(processID) \(command)\n"
+        }
+        return lines
+    }
+
+    static func arguments(of processID: pid_t, buffer: inout [UInt8]) -> ArraySlice<UInt8>? {
+        var mib = [CTL_KERN, KERN_PROCARGS2, processID]
+        var size = buffer.count
+        guard buffer.withUnsafeMutableBytes({ sysctl(&mib, 3, $0.baseAddress, &size, nil, 0) }) == 0 else {
+            return nil
+        }
+        return parseProcargs2(buffer[..<size])
+    }
+
+    /// The NUL-separated arguments in KERN_PROCARGS2 data: argc, the executable path, NUL padding,
+    /// then argc arguments, with the environment after them.
+    static func parseProcargs2(_ data: ArraySlice<UInt8>) -> ArraySlice<UInt8>? {
+        guard data.count > MemoryLayout<Int32>.size else { return nil }
+        let argumentCount = data.withUnsafeBytes { $0.loadUnaligned(as: Int32.self) }
+        var index = data.startIndex + MemoryLayout<Int32>.size
+        while index < data.endIndex, data[index] != 0 { index += 1 }
+        while index < data.endIndex, data[index] == 0 { index += 1 }
+        let start = index
+        var remaining = argumentCount
+        while index < data.endIndex, remaining > 0 {
+            if data[index] == 0 { remaining -= 1 }
+            index += 1
+        }
+        var end = index
+        while end > start, data[end - 1] == 0 { end -= 1 }
+        return data[start..<end]
+    }
+
+    private static func lowered<C: Collection>(_ bytes: C) -> [UInt8] where C.Element == UInt8 {
+        bytes.map { (65...90).contains($0) ? $0 + 32 : $0 }
+    }
+}
