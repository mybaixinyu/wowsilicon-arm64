diff --git a/Tests/WoWSiliconSwiftTests/ProcessArgumentsTests.swift b/Tests/WoWSiliconSwiftTests/ProcessArgumentsTests.swift
new file mode 100644
index 0000000..04ba596
--- /dev/null
+++ b/Tests/WoWSiliconSwiftTests/ProcessArgumentsTests.swift
@@ -0,0 +1,32 @@
+import Foundation
+import XCTest
+@testable import WoWSiliconSwift
+
+final class ProcessArgumentsTests: XCTestCase {
+    func testParsesArgumentsAndSkipsExecutablePathAndEnvironment() {
+        var data = [UInt8]()
+        withUnsafeBytes(of: Int32(2)) { data += $0 }
+        data += Array("/usr/bin/wine".utf8) + [0, 0, 0, 0]
+        data += Array("wine".utf8) + [0] + Array("Z:\\Games\\WoW.exe".utf8) + [0]
+        data += Array("HOME=/Users/tester".utf8) + [0]
+
+        let arguments = ProcessArguments.parseProcargs2(data[...])
+
+        XCTAssertEqual(arguments.map { Array($0) }, Array("wine\u{0}Z:\\Games\\WoW.exe".utf8))
+    }
+
+    func testListsTheCurrentProcessByAMarkerInItsArguments() throws {
+        let marker = (ProcessInfo.processInfo.arguments.first as NSString?)?.lastPathComponent ?? ""
+        XCTAssertFalse(marker.isEmpty)
+
+        let lines = try XCTUnwrap(ProcessArguments.commandLines(markers: [marker.uppercased()], names: []))
+
+        XCTAssertTrue(lines.split(separator: "\n").contains { $0.hasPrefix("\(getpid()) ") })
+    }
+
+    func testListsNothingForAnUnmatchedMarker() throws {
+        let lines = try XCTUnwrap(ProcessArguments.commandLines(markers: ["\u{1}no process has this\u{1}"], names: []))
+
+        XCTAssertEqual(lines, "")
+    }
+}
