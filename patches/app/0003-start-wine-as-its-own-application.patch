diff --git a/tools/wowsilicon-launch/wowsilicon-launch.c b/tools/wowsilicon-launch/wowsilicon-launch.c
new file mode 100644
index 0000000..b4a2bb4
--- /dev/null
+++ b/tools/wowsilicon-launch/wowsilicon-launch.c
@@ -0,0 +1,35 @@
+/* Runs a program in place of this process as its own application: without
+ * WoWSilicon's __CFBundleIdentifier, which every child of WoWSilicon inherits
+ * and which made WoW run about 7 % slower, and as its own responsible
+ * process, so macOS does not count the game as part of WoWSilicon. */
+
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern char **environ;
+extern int responsibility_spawnattrs_setdisclaim(posix_spawnattr_t *attrs, int disclaim);
+
+int main(int argc, char **argv)
+{
+    posix_spawnattr_t attrs;
+    int err;
+
+    if (argc < 2)
+    {
+        fprintf(stderr, "usage: %s program [argument...]\n", argv[0]);
+        return 2;
+    }
+
+    unsetenv("__CFBundleIdentifier");
+
+    posix_spawnattr_init(&attrs);
+    posix_spawnattr_setflags(&attrs, POSIX_SPAWN_SETEXEC);
+    if ((err = responsibility_spawnattrs_setdisclaim(&attrs, 1)))
+        fprintf(stderr, "wowsilicon-launch: cannot disclaim responsibility: %s\n", strerror(err));
+
+    err = posix_spawn(NULL, argv[1], NULL, &attrs, argv + 1, environ);
+    fprintf(stderr, "wowsilicon-launch: cannot run %s: %s\n", argv[1], strerror(err));
+    return 127;
+}
