+    /// `entries` with winerosetta first and libSiliconPatch second, the rest in
+    /// their order after them: wow_optimize has to load after both.
+    static func inLoadOrder(_ entries: [String]) -> [String] {
+        func rank(_ entry: String) -> Int {
+            switch entry.trimmingCharacters(in: .whitespaces).lowercased() {
+            case "mods/winerosetta.dll": return 0
+            case "mods/libsiliconpatch.dll", "libsiliconpatch.dll": return 1
+            default: return 2
+            }
+        }
+        return entries.enumerated()
+            .sorted { (rank($0.element), $0.offset) < (rank($1.element), $1.offset) }
+            .map(\.element)
+    }
