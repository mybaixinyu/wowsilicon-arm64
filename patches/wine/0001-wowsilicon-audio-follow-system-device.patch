+enum night_sample_kind
+{
+    NIGHT_SAMPLE_UNSUPPORTED,
+    NIGHT_SAMPLE_U8,
+    NIGHT_SAMPLE_S16,
+    NIGHT_SAMPLE_S32,
+    NIGHT_SAMPLE_F32,
+};
+
+static enum night_sample_kind get_night_sample_kind(const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    BOOL is_float = fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+        (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+         IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT));
+    BOOL is_pcm = fmt->wFormatTag == WAVE_FORMAT_PCM ||
+        (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+         IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM));
+
+    if (is_float && fmt->wBitsPerSample == 32) return NIGHT_SAMPLE_F32;
+    if (is_pcm && fmt->wBitsPerSample == 8) return NIGHT_SAMPLE_U8;
+    if (is_pcm && fmt->wBitsPerSample == 16) return NIGHT_SAMPLE_S16;
+    if (is_pcm && fmt->wBitsPerSample == 32) return NIGHT_SAMPLE_S32;
+    return NIGHT_SAMPLE_UNSUPPORTED;
+}
+
+static float read_night_sample(const BYTE *data, enum night_sample_kind kind, UINT32 index)
+{
+    switch (kind)
+    {
+    case NIGHT_SAMPLE_U8: return ((const UINT8 *)data)[index] / 127.5f - 1.0f;
+    case NIGHT_SAMPLE_S16: return ((const INT16 *)data)[index] / 32768.0f;
+    case NIGHT_SAMPLE_S32: return ((const INT32 *)data)[index] / 2147483648.0f;
+    case NIGHT_SAMPLE_F32: return ((const float *)data)[index];
+    default: return 0.0f;
+    }
+}
+
+static void write_night_sample(BYTE *data, enum night_sample_kind kind, UINT32 index, float value)
+{
+    value = max(-1.0f, min(1.0f, value));
+    switch (kind)
+    {
+    case NIGHT_SAMPLE_U8: ((UINT8 *)data)[index] = (UINT8)(value * 127.5f + 127.5f); break;
+    case NIGHT_SAMPLE_S16: ((INT16 *)data)[index] = (INT16)(value * 32767.0f); break;
+    case NIGHT_SAMPLE_S32: ((INT32 *)data)[index] = (INT32)(value * 2147483647.0f); break;
+    case NIGHT_SAMPLE_F32: ((float *)data)[index] = value; break;
+    default: break;
+    }
+}
+
+static void process_normalize_audio(struct coreaudio_stream *stream, BYTE *data, UINT32 frames)
+{
+    const float threshold = 0.12f, ratio = 0.25f, makeup = 1.8f;
+    enum night_sample_kind kind = get_night_sample_kind(stream->fmt);
+    float envelope = stream->normalize_envelope;
+    float gain = stream->normalize_gain > 0.0f ? stream->normalize_gain : 1.0f;
+    float attack = min(1.0f, 1.0f / (0.005f * stream->fmt->nSamplesPerSec));
+    float release = min(1.0f, 1.0f / (0.25f * stream->fmt->nSamplesPerSec));
+    UINT32 channels = stream->fmt->nChannels;
+    UINT32 frame, channel;
+
+    if (kind == NIGHT_SAMPLE_UNSUPPORTED) return;
+
+    for (frame = 0; frame < frames; ++frame)
+    {
+        float peak = 0.0f, target;
+        for (channel = 0; channel < channels; ++channel)
+        {
+            float sample = fabsf(read_night_sample(data, kind, frame * channels + channel));
+            peak = max(peak, sample);
+        }
+
+        envelope += (peak - envelope) * (peak > envelope ? attack : release);
+        target = envelope > threshold
+            ? (threshold + (envelope - threshold) * ratio) / envelope
+            : 1.0f;
+        target *= makeup;
+        gain += (target - gain) * (target < gain ? attack : release);
+
+        for (channel = 0; channel < channels; ++channel)
+        {
+            UINT32 index = frame * channels + channel;
+            write_night_sample(data, kind, index, read_night_sample(data, kind, index) * gain);
+        }
+    }
+
+    stream->normalize_envelope = envelope;
+    stream->normalize_gain = gain;
+}
